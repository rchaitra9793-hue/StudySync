# StudySync settings
# 1. Copy this file and name the copy ".env" (in this same server folder)
# 2. Fill in what you need (everything is optional on your own computer)
# 3. Restart the server
#
# On Vercel, don't upload .env – add these in Settings → Environment Variables instead.
# Never share your .env file or upload it to GitHub.

# ---------- Database ----------
# Leave empty to save data in server/data/db.json (fine on your own computer).
# For the live website, paste your MongoDB Atlas connection string:
#   mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=

# ---------- Email (verification & password reset codes) ----------
# Gmail (works on your own computer and on Vercel)
#   SMTP_PASS must be a Gmail "App Password", NOT your normal Gmail password:
#   - Turn on 2-Step Verification: https://myaccount.google.com/security
#   - Create an App Password:      https://myaccount.google.com/apppasswords
SMTP_USER=
SMTP_PASS=

# Optional – Brevo instead of Gmail (https://www.brevo.com → SMTP & API → API Keys)
#   EMAIL_FROM must be a sender address you verified in Brevo
BREVO_API_KEY=
EMAIL_FROM=

# If no email is set up, codes are printed in the server terminal instead.
